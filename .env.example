# SignalDeck works without third-party API keys.
DATABASE_PATH=./data/signaldeck.db

# Optional: protect /api/cron/fetch when deployed on a VPS.
CRON_SECRET=

# Optional: local Ollama scoring. No registration/API key required.
# Example: qwen3:8b or llama3.1:8b
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
